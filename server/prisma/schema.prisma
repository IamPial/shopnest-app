
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//user table model
model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean @default(false)
  role UserRole @default(CUSTOMER)

  orders Orders[]


  @@map("users")
}

enum UserRole{
  ADMIN
  CUSTOMER
}


//product table model

model Products{
  id String @id @default(uuid())
  title String 
  description String
  stock Int
  price Decimal
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean @default(false)
  categoryId String 
  category  Category @relation(fields: [categoryId], references: [id])

  @@map("products")

}


//category table model
model Category{
  id String @id @default(uuid())
  name String @unique
  isDelete Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Products[] 

  @@map("categories")
}


//order table model
model Orders {
  id String @id @default(uuid())
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])

  @@map("orders")
}






